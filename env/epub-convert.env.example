# Config for epub-convert
# Copy to env/epub-convert.env and fill in your values (never commit the real file)

ABS_HOST=http://192.168.0.102:13378
ABS_TOKEN=your_api_token_here
EBOOKS_LIBRARY_ID=9f4820bb-a3fe-4287-8764-b81a33d9ef0a

# Filesystem paths — must match the bind mount in the service unit and docker-compose.yml
EBOOKS_DIR=/zfs/media_root/ebooks
ABS_EBOOKS_PREFIX=/mnt/media_root/ebooks
