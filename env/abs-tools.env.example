# Shared config for abs-auto-match and abs-chapter-match
# Copy to env/abs-tools.env and fill in your values (never commit the real file)

ABS_HOST=http://192.168.0.102:13378
ABS_TOKEN=your_api_token_here
AUDIOBOOKS_LIBRARY_ID=d2042a1b-04b0-4bde-8a8a-979929a2a7ba
EBOOKS_LIBRARY_ID=9f4820bb-a3fe-4287-8764-b81a33d9ef0a

# Chapter-match tuning (optional — these are the defaults)
# CHAPTER_THRESHOLD=3
# CHAPTER_PROVIDER=audible.com
# CHAPTER_REGION=US
# SEARCH_FOR_ASIN=true
# USE_TRACKS_AS_CHAPTERS=false
# DISABLE_RATE_PROTECTION=false
