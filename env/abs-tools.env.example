# ── Required ──────────────────────────────────────────────────────────────────
ABS_HOST=http://192.168.0.102:13378
ABS_TOKEN=your_api_token_here
AUDIOBOOKS_LIBRARY_ID=your_audiobooks_library_id_here
EBOOKS_LIBRARY_ID=your_ebooks_library_id_here

# ── Enable/disable tools (default: true) ──────────────────────────────────────
# ENABLE_AUTO_MATCH=true
# ENABLE_CHAPTER_MATCH=true
# ENABLE_EPUB_CONVERT=true

# ── Schedules (cron format, defaults shown) ───────────────────────────────────
# SCHEDULE_AUTO_MATCH=0 * * * *
# SCHEDULE_CHAPTER_MATCH=5 * * * *
# SCHEDULE_EPUB_CONVERT=10 * * * *
# SCHEDULE_EPUB_CONVERT_FULL=30 2 * * 0

# ── epub-convert paths ────────────────────────────────────────────────────────
# Mount your ebooks directory to /ebooks in docker-compose.yml, or override here.
# EBOOKS_DIR=/ebooks
# Path as Audiobookshelf sees it internally (used for duplicate-fix path translation)
# ABS_EBOOKS_PREFIX=/mnt/media_root/ebooks

# ── Chapter match tuning (optional) ──────────────────────────────────────────
# CHAPTER_THRESHOLD=3
# CHAPTER_PROVIDER=audible.com
# CHAPTER_REGION=US
# SEARCH_FOR_ASIN=true
# USE_TRACKS_AS_CHAPTERS=false
# DISABLE_RATE_PROTECTION=false
