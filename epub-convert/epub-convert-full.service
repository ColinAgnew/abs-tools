[Unit]
Description=EPUB2→EPUB3 conversion — full library scan

[Service]
Type=oneshot
EnvironmentFile=/etc/abs-tools/epub-convert.env
ExecStart=/usr/bin/docker run --rm \
    --user 1000:1000 \
    --env-file /etc/abs-tools/epub-convert.env \
    -v /var/log/abs-tools:/var/log/abs-tools \
    -v /var/lib/abs-tools:/var/lib/abs-tools \
    -v ${EBOOKS_DIR}:${EBOOKS_DIR} \
    ghcr.io/colinagnew/abs-tools-epub:latest --full
StandardOutput=append:/var/log/abs-tools/epub-convert.log
StandardError=append:/var/log/abs-tools/epub-convert.log
